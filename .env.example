# Browser-safe values (frontend/.env or root .env for local tooling)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend API base URL used by the frontend (owner setup page).
# Default: http://localhost:4000  — only override in production.
VITE_API_URL=http://localhost:4000

# Server-only values (backend/.env). Never expose this key to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000
FRONTEND_URL=http://localhost:5173
