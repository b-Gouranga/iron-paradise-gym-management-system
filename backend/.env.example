# Server configuration
PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase database & auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Messaging Provider: "mock" (default, local/tests) or "meta" (production)
MESSAGING_PROVIDER=mock

# Meta WhatsApp Cloud API (Required only when MESSAGING_PROVIDER=meta)
META_WHATSAPP_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-whatsapp-business-account-id
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_VERIFY_TOKEN=your-random-webhook-verification-token
META_WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-verification
